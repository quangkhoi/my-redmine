{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3001",
      "http://127.0.0.1:3001"
    ]
  },
  "Redmine": {
    "BaseUrl": "https://redmine.wdm.co.jp/",
    "ProxyUrl": "https://redmine-https-proxy.qkhoiwork.workers.dev",
    "ApiKey": "REPLACE_ME",
    "BasicUser": "REPLACE_ME",
    "BasicPass": "REPLACE_ME"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
